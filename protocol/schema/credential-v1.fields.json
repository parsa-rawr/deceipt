{
 "revision": "deceipt-proto-r3",
 "schema": "deceipt.credential-v1",
 "top_level": "map",
 "container": "COSE_Sign1 [protected, {}, payload, signature], signature EdDSA (Ed25519) over Sig_structure ['Signature1', protected, h'', payload]",
 "protected_headers": {
  "1": "alg = -8 (EdDSA)",
  "3": "content type = application/deceipt-credential+cbor",
  "4": "key id = issuer identifier (bstr16)"
 },
 "fields": [
  {
   "label": 1,
   "name": "credential_version",
   "type": "uint",
   "required": true,
   "rule": "MUST be 1"
  },
  {
   "label": 2,
   "name": "issuer_id",
   "type": "bstr16",
   "required": true,
   "rule": "MUST equal protected kid"
  },
  {
   "label": 3,
   "name": "merchant_id",
   "type": "bstr16",
   "required": true,
   "rule": "stable merchant identifier"
  },
  {
   "label": 4,
   "name": "device_key_id",
   "type": "bstr16",
   "required": true,
   "rule": "MUST equal the receipt COSE kid"
  },
  {
   "label": 5,
   "name": "device_public_key",
   "type": "bstr32",
   "required": true,
   "rule": "Ed25519 public key"
  },
  {
   "label": 6,
   "name": "valid_from",
   "type": "uint",
   "required": true,
   "rule": "unix seconds, inclusive"
  },
  {
   "label": 7,
   "name": "valid_until",
   "type": "uint",
   "required": true,
   "rule": "unix seconds, exclusive; > valid_from"
  },
  {
   "label": 8,
   "name": "capabilities",
   "type": "uint",
   "required": true,
   "rule": "bitmask CAP_*"
  },
  {
   "label": 9,
   "name": "merchant_reference",
   "type": "tstr",
   "required": true,
   "rule": "matches receipt merchant label 3"
  },
  {
   "label": 10,
   "name": "display_name",
   "type": "tstr",
   "required": true,
   "rule": "<=128 utf-8 bytes, NFC"
  },
  {
   "label": 11,
   "name": "issued_at",
   "type": "uint",
   "required": true,
   "rule": "credential issuance time"
  }
 ],
 "capabilities": {
  "CAP_ISSUE_SALE": 1,
  "CAP_ISSUE_REFUND": 2,
  "CAP_ISSUE_VOID": 4,
  "CAP_RECEIVE_TRANSFER": 8,
  "CAP_EMBED_CREDENTIAL": 16
 },
 "max_bytes": 1024,
 "unknown_field_policy": "unknown label => CREDENTIAL_MALFORMED (fatal)"
}
