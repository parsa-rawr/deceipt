; Deceipt Wire v1 — CDDL
; Revision: deceipt-proto-r1 (FROZEN for the PoC)
; Control messages are CBOR maps with integer labels; the envelope carries them.

; ---------------------------------------------------------------------------
; Envelopes (COMMAND / EVENT characteristics)
; ---------------------------------------------------------------------------

envelope = plaintext-envelope / aead-envelope

plaintext-envelope = bytes .cbor [0x00]       ; then CBOR control message follows
; On the wire: 0x00 || CBOR(control)          (ClientHello / ServerHello only)

aead-envelope = bytes .cbor [0x01, counter]   ; then AES-256-GCM ciphertext||tag
; On the wire: 0x01 || u64_be(counter) || AES-256-GCM(key, nonce(counter), aad, CBOR(control))
; nonce = 00000000 || u64_be(counter)   (12 bytes)

counter = uint .le 18446744073709551615

; ---------------------------------------------------------------------------
; LPdu segmentation (COMMAND / EVENT fragments)
; ---------------------------------------------------------------------------

lpdu-fragment = u16 .be msg-seq ‖ u8 frag-index ‖ u8 frag-count ‖ bytes
msg-seq   = uint .le 4095        ; strictly increasing per sender per session
frag-index = uint
frag-count = uint .ge 1 .le 512

; ---------------------------------------------------------------------------
; DATA frames (DATA characteristic)
; ---------------------------------------------------------------------------

data-frame = transfer-id ‖ u32 .be sequence-number ‖ frame-payload
sequence-number = uint
; A DataFrame's payload length depends on its POSITION in the transfer:
;   * every non-final frame carries exactly frame_size bytes (negotiated 16..512);
;   * the FINAL frame carries ciphertext_length - frame_size*(frame_count-1) bytes,
;     which is 1..frame_size and MAY be below 16.
; The frozen framing-valid.json transfer ends on a 4-byte final frame, which is valid.
; Only a non-final frame shorter than 16 bytes, or any frame longer than frame_size,
; is FRAME_SIZE_INVALID. CDDL cannot see position, so the type below is the union and
; the rule above is normative.
frame-payload = frame-payload-nonfinal / frame-payload-final
frame-payload-nonfinal = bytes .size (16..512)
frame-payload-final    = bytes .size (1..512)

transfer-id  = bstr .size 16
session-id   = bstr .size 16
receipt-id   = bstr .size 16

; ---------------------------------------------------------------------------
; Control messages
; ---------------------------------------------------------------------------

control-message = client-hello / server-hello / accept / ack / receipt-ack
                / cancel / retry / receipt-offer / transfer-begin
                / transfer-complete / error-msg

client-hello = {
  1 : 0x01,
  2 : 1,                          ; protocol_version
  3 : [+ uint],                   ; crypto_suites (must intersect {1})
  4 : session-id,
  5 : bstr .size 32,              ; client_nonce
  6 : bstr .size 65,              ; client_ephemeral_pubkey (0x04||X||Y)
  7 : bstr .size 32,              ; binding_proof
  8 : uint .le 512,               ; max_frame_payload
}

server-hello = {
  1 : 0x11,
  2 : 1,
  3 : uint,                       ; suite_id
  4 : transfer-id,
  5 : bstr .size 32,              ; server_nonce
  6 : bstr .size 65,              ; server_ephemeral_pubkey
  7 : bstr,                       ; merchant_credential (<= 1024)
  8 : bstr .size 64,              ; transcript_signature
  9 : bstr .size 32,              ; binding_tuple_digest
}

accept = {
  1 : 0x02,
  2 : transfer-id,
  3 : uint,                       ; protocol_version
  4 : uint,                       ; suite_id
}

ack = {
  1 : 0x03,
  2 : transfer-id,
  3 : uint,                       ; highest_contiguous_sequence
}

receipt-ack = {
  1 : 0x04,
  2 : transfer-id,
  3 : receipt-id,
  4 : uint,                       ; outcome: 1 trusted 2 unknown_issuer 3 already_imported 4 rejected
}

cancel = {
  1 : 0x05,
  ? 2 : transfer-id,
  ? 3 : uint,                     ; error_code
}

retry = {
  1 : 0x06,
  2 : transfer-id,
  3 : uint,                       ; from_sequence
}

receipt-offer = {
  1 : 0x12,
  2 : transfer-id,
  3 : receipt-id,
  4 : tstr,                       ; merchant_reference
  5 : uint,                       ; total_amount_minor
  6 : tstr .size (3..3),          ; currency
  7 : uint,                       ; issued_at
  8 : 1 / 2 / 3,                  ; kind
  9 : uint,                       ; ciphertext_length
  10 : bstr .size 16,             ; merchant_id
  11 : bstr .size 32,             ; credential_hash
  12 : session-id,
}

transfer-begin = {
  1 : 0x13,
  2 : transfer-id,
  3 : uint,                       ; ciphertext_length
  4 : bstr .size 32,              ; payload_hash
  5 : uint .le 512,               ; frame_size
  6 : uint,                       ; frame_count
}

transfer-complete = {
  1 : 0x14,
  2 : transfer-id,
  3 : uint,                       ; frame_count
  4 : bstr .size 32,              ; payload_hash
}

error-msg = {
  1 : 0x15,
  2 : uint,                       ; error_code (see protocol/vectors/errors.json)
  3 : bool,                       ; fatal
  ? 4 : transfer-id,
  ? 5 : tstr,                     ; detail (<= 64 bytes, no secrets)
}

; ---------------------------------------------------------------------------
; Binding bytes (adopted verbatim from A2; see docs/protocol/handshake.md §10)
; ---------------------------------------------------------------------------

binding-tuple = [1, session-id, transfer-id, receipt-id, offer-hash]   ; CBOR array(5), 87 bytes
offer-hash = bstr .size 32
