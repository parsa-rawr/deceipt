; DeceiptMerchantCredentialV1 — CDDL
; Revision: deceipt-proto-r1 (FROZEN for the PoC)
; Container: COSE_Sign1, EdDSA (-8), issuer signature.
; Sig_structure = ["Signature1", protected_bstr, h'', payload_bstr]

merchant-credential-v1 = [
  protected : bstr .cbor credential-protected-header,
  unprotected : {},                 ; MUST be empty
  payload : bstr .cbor deceipt-merchant-credential-v1,
  signature : bstr .size 64
]

credential-protected-header = {
  1 : -8,                           ; alg = EdDSA
  3 : "application/deceipt-credential+cbor",
  4 : issuer-id,                    ; kid = issuer/anchor id
}

deceipt-merchant-credential-v1 = {
  1  : 1,                           ; credential_version
  2  : issuer-id,                   ; issuer_id (== protected kid)
  3  : merchant-id,                 ; merchant_id
  4  : device-key-id,               ; device_key_id (== receipt protected kid)
  5  : bstr .size 32,               ; device_public_key (Ed25519)
  6  : uint,                        ; valid_from (inclusive)
  7  : uint,                        ; valid_until (exclusive)
  8  : uint,                        ; capabilities bitmask
  9  : tstr,                        ; merchant_reference (== receipt merchant.reference)
  10 : tstr,                        ; display_name
  11 : uint,                        ; issued_at
}

issuer-id   = bstr .size 16
merchant-id = bstr .size 16
device-key-id = bstr .size 16

capability = &(
  CAP_ISSUE_SALE       : 1,         ; 0x0001
  CAP_ISSUE_REFUND     : 2,         ; 0x0002
  CAP_ISSUE_VOID       : 4,         ; 0x0004
  CAP_RECEIVE_TRANSFER : 8,         ; 0x0008
  CAP_EMBED_CREDENTIAL : 16,        ; 0x0010
)

; Trust anchor entry (protocol/vectors/fixtures/trust-anchors-v1.json), public only:
trust-anchor = {
  anchor_id_hex : tstr .size (32..32),
  algorithm : "EdDSA",
  cose_alg : -8,
  public_key_hex : tstr .size (64..64),
  label : tstr,
  test_only : bool,
}
