{
  "$comment": "Deceipt PoC - checkout-flow contract v1. Owner A2. Binding bytes ADOPTED by A1 into frozen revision deceipt-proto-r1 (docs/protocol/handshake.md section 10); the QR bootstrap remains a provisional PRODUCT flow that A1/A0 may replace. Machine-readable companion to docs/flows/transaction-binding-and-checkout-v1.md. No secrets: session_binding_token/private material appear only as test-only deterministic vectors under protocol/flows/vectors/.",
  "schema": "deceipt.checkout-flow/v1",
  "status": "binding_bytes_adopted_in_deceipt-proto-r1__product_flow_provisional",
  "owner": "A2",
  "revision": "deceipt-proto-r1",
  "consumes": ["DESIGN.md#2.5", "DESIGN.md#7.2", "DESIGN.md#7.3", "DESIGN.md#8", "DESIGN.md#9", "DESIGN.md#11", "DESIGN.md#13"],
  "adopted_by": "A1 docs/protocol/handshake.md section 10",

  "invariants": {
    "no_rssi": {
      "statement": "RSSI, tx_power, distance, and any radio-derived proximity MUST NOT be an input to eligibility, selection, ordering, connection target, or trust.",
      "forbidden_fields_in_selection": ["rssi", "RSSI", "txPower", "tx_power", "distance", "proximity", "signalStrength"],
      "picker_sort_key": "peripheral_id",
      "picker_sort_direction": "ascending",
      "diagnostics_only": true
    },
    "ambiguity_rule": {
      "source": "DESIGN.md#7.3",
      "zero_candidates": "continue_scanning",
      "one_eligible": "may_auto_connect",
      "two_or_more_eligible": "explicit_disambiguation_required",
      "fails_closed": true
    },
    "session_binding_distinct_from_key_trust": true,
    "decryption_implies_trust": false
  },

  "primary_flow": "P1_qr_bootstrap_ble_delivery",
  "fallback_flow": "P0_manual_disambiguation_picker",

  "qr": {
    "prefix": "deceipt1:",
    "encoding": "base64url_nopad",
    "format_version": 1,
    "cbor": {
      "type": "map",
      "definite_length": true,
      "integer_keys_ascending": true,
      "fields": {
        "1": {"name": "qr_format_version", "type": "uint", "value": 1},
        "2": {"name": "session_id", "type": "bstr", "length": 16},
        "3": {"name": "session_binding_token", "type": "bstr", "length": 16, "secret": true, "never_logged": true},
        "4": {"name": "offer_hash", "type": "bstr", "length": 32},
        "5": {"name": "expires_at_unix", "type": "uint64"}
      }
    },
    "must_not_contain": ["merchant_name", "amount", "receipt_id", "line_items", "customer_data", "merchant_credential", "receipt_payload"]
  },

  "binding_bytes": {
    "point_requirement": {
      "field": "client_ephemeral_pubkey",
      "encoding": "P-256 uncompressed 0x04||X||Y (65 bytes)",
      "must_decode_on": "secp256r1",
      "error_on_failure": "HANDSHAKE_ECDH_INVALID_POINT",
      "checked_before": "binding proof verification"
    },
    "offer_hash": {
      "alg": "SHA-256",
      "prefix_ascii": "deceipt-offer-hash-v1",
      "separator_hex": "00",
      "message": "prefix || 00 || cbor([session_id(16), transfer_id(16), receipt_id(16), merchant_reference(tstr), total_amount_minor(uint), currency(tstr), issued_at_unix(uint)])",
      "length": 32,
      "recomputed_from": "RECEIPT_OFFER labels 2,3,4,5,6,7,12",
      "frozen_value_v1": "efdc44f3a6d088fcd23ee9fb8f9b65f464572da83de53f0ce37a5d21c994d4c5"
    },
    "binding_tuple": {
      "cbor": "array(5)",
      "length_bytes": 87,
      "elements": [
        {"index": 0, "name": "binding_format_version", "type": "uint", "value": 1},
        {"index": 1, "name": "session_id", "type": "bstr", "length": 16},
        {"index": 2, "name": "transfer_id", "type": "bstr", "length": 16},
        {"index": 3, "name": "receipt_id", "type": "bstr", "length": 16},
        {"index": 4, "name": "offer_hash", "type": "bstr", "length": 32}
      ],
      "encoding": "RFC8949 deterministic: definite lengths, minimal integer encodings",
      "wire_prefix_hex": "8501",
      "frozen_value_v1": "85015000112233445566778899aabbccddeeff50ffeeddccbbaa99887766554433221100500123456789abcdef0123456789abcdef5820efdc44f3a6d088fcd23ee9fb8f9b65f464572da83de53f0ce37a5d21c994d4c5",
      "transcript_offset": {"len_prefix_offset": 284, "tuple_offset": 285}
    },
    "binding_tuple_digest": {
      "alg": "SHA-256",
      "prefix_ascii": "deceipt-binding-tuple-v1",
      "separator_hex": "00",
      "message": "prefix || 00 || binding_tuple",
      "length": 32,
      "transcript_offset": 250,
      "coverd_by": "ServerHello.transcript_signature (Ed25519)",
      "frozen_value_v1": "d9d3d7df72b1e4df615c68dabac1f8fb6eb24371efe9cde6bfda2985abde59e2"
    },
    "binding_proof": {
      "alg": "HMAC-SHA-256",
      "key": "session_binding_token",
      "prefix_ascii": "deceipt-binding-proof-v1",
      "separator_hex": "00",
      "message": "prefix || 00 || client_nonce(32) || client_ephemeral_pubkey(65)",
      "message_length_bytes": 122,
      "output_length": 32,
      "carried_in": "ClientHello.binding_proof (field 7)",
      "compare": "constant_time",
      "frozen_value_v1": "fa19790fda7c85c1c745d4299c4177f9bcd15090de78961a38b7ebc36565083e"
    },
    "sbt_key_rationale": {
      "bits": 128,
      "source": "CSPRNG, fresh per session, single-use, TTL 300s",
      "hmac_key_security_bits": 128,
      "not_password_derived": true,
      "length_extension_not_applicable": true,
      "hardening_path_not_in_r1": "HKDF-SHA-256(ikm=SBT_32_random, salt=session_id, info=\"deceipt-binding-key-v1\") -> 256-bit HMAC key; requires revision bump + A1 re-adoption because it changes every binding_proof byte"
    }
  },

  "client_hello_additions": [
    {"name": "session_id", "type": "bstr", "length": 16, "field": 4},
    {"name": "client_nonce", "type": "bstr", "length": 32, "field": 5},
    {"name": "client_ephemeral_pubkey", "type": "bstr", "length": 65, "curve": "P-256", "form": "uncompressed 0x04||X||Y", "field": 6},
    {"name": "binding_proof", "type": "bstr", "length": 32, "field": 7}
  ],

  "merchant_binding_check": [
    {"step": 1, "action": "resolve session_id to live, unconsumed, unexpired session", "fail": "BINDING_UNKNOWN_SESSION"},
    {"step": 2, "action": "client_ephemeral_pubkey decodes as P-256", "fail": "HANDSHAKE_ECDH_INVALID_POINT"},
    {"step": 3, "action": "constant_time_compare(HMAC-SHA-256(SBT, proof_message), binding_proof)", "fail": "BINDING_PROOF_INVALID"},
    {"step": 4, "action": "mark session claimed by (client_nonce, client_ephemeral_pubkey)"}
  ],

  "expiration": {
    "qr_validity": {"owner": "merchant", "ttl_seconds": 300, "handshake_const": "T_BINDING_QR", "value_field": "expires_at_unix", "effect": "client refuses to start session from expired QR", "error": "BINDING_STALE"},
    "session_lifetime": {"handshake_const_session": "T_SESSION=120s", "handshake_const_advertise": "T_ADVERTISE=60s", "error": "SESSION_EXPIRED"},
    "consumption": {"trigger": "first accepted ClientHello with valid binding_proof", "second_attempt_error": "BINDING_CONSUMED", "purpose": "anti-replay for the binding"}
  },

  "states": ["ready", "selecting", "connecting", "transferring", "verifying", "saved", "recoverable_failure"],

  "transitions": [
    {"from": "ready", "to": "selecting", "trigger": "user scans QR or opens picker"},
    {"from": "selecting", "to": "ready", "trigger": "0 eligible candidates", "behavior": "keep scanning"},
    {"from": "selecting", "to": "connecting", "guard": "exactly one candidate selected by explicit user act; 2+ eligible with no selection is unreachable"},
    {"from": "connecting", "to": "recoverable_failure", "trigger": "connect failure/timeout"},
    {"from": "connecting", "to": "transferring", "guard": "point decodes AND binding check passed AND merchant credential + transcript signature verified (DESIGN.md#9 steps 3-4)"},
    {"from": "transferring", "to": "recoverable_failure", "trigger": "cancel | disconnect | bluetooth_off"},
    {"from": "transferring", "to": "verifying", "guard": "full AEAD payload authenticated/decrypted (DESIGN.md#9 step 7)"},
    {"from": "verifying", "to": "saved", "guard": "ALL of DESIGN.md#9 steps 10-15 pass"},
    {"from": "verifying", "to": "recoverable_failure", "trigger": "any DESIGN.md#9 verification failure"}
  ],

  "selection_invariants": {
    "selected_writers": ["onQRScanned", "onCandidateTapped"],
    "eligibility_predicate_excludes": ["rssi", "txPower", "distance"],
    "connection_target": "selected_only",
    "auto_connect_requires": "exactly_one_eligible_candidate",
    "recovery_may_auto_target_different_peer": false
  },

  "errors": [
    {"code": "BINDING_UNKNOWN_SESSION", "meaning": "session_id does not resolve to a live session", "owner": "A1", "wire_code": "0x0312"},
    {"code": "BINDING_PROOF_INVALID", "meaning": "binding_proof HMAC mismatch", "owner": "A1", "wire_code": "0x0313"},
    {"code": "BINDING_STALE", "meaning": "QR or session expired before use", "owner": "A1", "wire_code": "0x0314"},
    {"code": "BINDING_CONSUMED", "meaning": "binding already used once", "owner": "A1", "wire_code": "0x0315"},
    {"code": "BINDING_REQUIRED", "meaning": "binding required but absent", "owner": "A1", "wire_code": "0x0316"},
    {"code": "HANDSHAKE_ECDH_INVALID_POINT", "meaning": "client_ephemeral_pubkey does not decode on P-256", "owner": "A1"},
    {"code": "WRONG_TRANSACTION", "meaning": "offer does not match the selected/QR-bound transaction", "owner": "A1", "wire_code": "0x0614"},
    {"code": "USER_CANCELLED", "meaning": "user cancelled", "owner": "A3"},
    {"code": "TRANSPORT_BLUETOOTH_OFF", "meaning": "Bluetooth disabled", "owner": "A3"},
    {"code": "PERMISSION_DENIED", "meaning": "Bluetooth or camera permission denied", "owner": "A3"},
    {"code": "NO_ELIGIBLE_TERMINAL", "meaning": "no candidate advertising the Deceipt service UUID", "owner": "A3"}
  ],

  "user_visible_failures": {
    "wrong_terminal": {"state": "recoverable_failure", "message": "This isn't the transaction you selected.", "recovery": "rescan_or_reopen_picker"},
    "expired_transaction": {"state": "recoverable_failure", "message": "This checkout code has expired. Ask the merchant to show a new one.", "recovery": "rescan_fresh_qr"},
    "denied_bluetooth_permission": {"state": "pre_selecting", "message": "Deceipt needs Bluetooth to receive your receipt.", "recovery": "settings_deeplink_then_retry"},
    "denied_camera_permission": {"state": "pre_selecting", "message": "Scanning needs camera access.", "recovery": "grant_or_use_picker"},
    "cancellation": {"state": "recoverable_failure", "message": "Cancelled.", "recovery": "rescan_or_retry"},
    "bluetooth_disabled": {"state": "recoverable_failure", "message": "Bluetooth is off.", "recovery": "enable_then_retry"},
    "no_eligible_terminal": {"state": "selecting", "message": "No Deceipt terminal found nearby.", "recovery": "keep_scanning"},
    "multiple_unselected": {"state": "selecting", "message": "Select a terminal to receive from.", "recovery": "explicit_tap",
      "copy_must_state": "selection is manual and never by signal strength"}
  },

  "customer_display": {
    "show": ["merchant_name_with_verification_outcome", "total_currency_amount_minor", "receipt_timestamp", "verification_status_plain_language", "recovery_affordances"],
    "never_show": ["key_ids", "signature_bytes", "nonces", "transcript_hashes", "session_ids", "session_binding_token", "transport_success_as_trust"],
    "verification_outcomes": ["trusted", "unknown_key", "rejected"]
  },

  "friction_budget": {
    "claim": "protocol-required_observed_step_count_only",
    "zero_taps_claimed": false,
    "note": "OS permission prompts and real-device timing unknown until A4/A5 device testing",
    "P1_phases": [
      {"n": 1, "phase": "grant_permissions", "automatic": false},
      {"n": 2, "phase": "scan_qr", "automatic": false},
      {"n": 3, "phase": "connect_handshake_binding", "automatic": true},
      {"n": 4, "phase": "review_offer_accept", "automatic": false},
      {"n": 5, "phase": "save_and_verify", "automatic": true}
    ],
    "P1_internal_protocol_actions_between_scan_and_accept": 9,
    "P0_extra_user_act_vs_P1": ["tap_one_candidate"],
    "failure_path_extra_explicit_acts": 1
  },

  "a1_dependencies": {
    "status": "closed - adopted into deceipt-proto-r1 (handshake.md section 10)",
    "items": [
      {"requirement": "binding_tuple_digest required in signed transcript", "satisfied": true, "where": "transcript offset 250"},
      {"requirement": "ClientHello carries session_id, client_nonce, client_ephemeral_pubkey, binding_proof", "satisfied": true, "where": "fields 4,5,6,7"},
      {"requirement": "RECEIPT_OFFER carries offer-hash members", "satisfied": true, "where": "labels 2-7,12"},
      {"requirement": "wire IDs for 16-byte identifiers", "satisfied": true, "where": "bstr(16)"},
      {"requirement": "typed binding errors", "satisfied": true, "where": "0x0312..0x0316, 0x0614"},
      {"requirement": "32-byte client_nonce", "satisfied": true, "where": "handshake.md section 1"}
    ]
  },

  "vectors_file": "protocol/flows/vectors/binding-v1.json",
  "vector_generator": "protocol/flows/tools/gen_binding_vectors.py",
  "vectors_note": "V1 reconciles byte-for-byte with A1 protocol/vectors/handshake-valid.json; all non-negative vectors use valid P-256 points; V4 is a deliberate invalid-point negative vector. See docs/flows/transaction-binding-and-checkout-v1.md section 13 (defect fix record)."
}
